# ─── Datenquelle (eine der beiden reicht) ─────────────────────────────────────

# Option A: Apify  ← EMPFOHLEN (einfacher, kein Google Cloud nötig)
# Account: https://apify.com  →  Settings → Integrations → API token kopieren
# Kosten: $5 Gratisguthaben/Monat, danach ~$3 pro 1.000 Suchergebnisse
APIFY_TOKEN=apify_api_...dein_key_hier

# Option B: Google Places API  (präzisere Radius-Filterung)
# Anleitung: https://console.cloud.google.com  →  APIs & Dienste → Places API aktivieren → Anmeldedaten
# Kosten: $200 Gratisguthaben/Monat = ~6.000 Suchen kostenlos
GOOGLE_API_KEY=AIzaSy...dein_key_hier

# Alle gesetzten Quellen laufen parallel und werden zusammengeführt.
# PageSpeed Insights (für Website-Scores) läuft kostenlos ohne Key.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
